APP_NAME="Hova Music"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file

# Admin paneli yolu: tahmin edilemeyen, en az 16 karakterlik rastgele bir değer.
# Örnek üretim: php -r "echo bin2hex(random_bytes(12));"
ADMIN_PATH=
# Virgülle ayrılmış IP veya CIDR listesi. Boşsa kısıtlama yok; admin panelindeki listeye ek olarak uygulanır.
ADMIN_ALLOWED_IPS=

HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hovamusic
DB_USERNAME=hovamusic
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=hovamusic_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Kullanıcı dosyalarının (kapak, ses, rapor, vergi formu) tutulduğu, webroot dışındaki dizin.
PRIVATE_STORAGE_PATH=/var/hovamusic/private

MAIL_MAILER=log
MAIL_FROM_ADDRESS="bildirim@hovamusic.com"
MAIL_FROM_NAME="Hova Music"
RESEND_API_KEY=

# Cloudflare Turnstile. Geliştirmede Cloudflare'in test anahtarları kullanılabilir.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Polar.sh (ödeme). Erişim anahtarı Polar > Settings > Developers; webhook adresi
# https://alanadi/webhooks/polar, gizli anahtar webhook oluşturulurken verilir.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox

# Faz 2
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# ffprobe PATH'te değilse tam yolu (ses dosyası kontrolü).
FFPROBE_PATH=ffprobe

# Proxy arkasında çalışırken güvenilen proxy IP'leri (virgülle). Cloudflare kullanılıyorsa Cloudflare aralıkları.
TRUSTED_PROXIES=

VITE_APP_NAME="${APP_NAME}"
